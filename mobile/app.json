{
  "expo": {
    "name": "Fork",
    "slug": "fork",
    "scheme": "fork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aryan5v.fork",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.aryan5v.fork",
      "adaptiveIcon": {
        "backgroundColor": "#07070A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-video",
      "expo-image",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Fork listens only while you hold the microphone, so you can answer a character out loud."
        }
      ]
    ]
  }
}
