# Copy to .env and fill in. run.sh sources this file when it exists.
# Never commit .env.

# Required. Bearer key the app and the backend send in the Authorization header.
SEGMENT_API_KEY=

# auto | sam3 | dino_sam2 | stub. `auto` uses SAM 3 when its weights are
# reachable and otherwise Grounding DINO + SAM 2.1.
SEGMENT_ENGINE=auto
SEGMENT_DEVICE=auto
SEGMENT_HOST=0.0.0.0
SEGMENT_PORT=8000
SEGMENT_MAX_CONCURRENCY=1

# Hugging Face token. Only needed for the gated SAM 3 repos (facebook/sam3,
# facebook/sam3.1): accept the SAM License on the model page, then paste a
# read token here.
HF_TOKEN=

# Frame intake limits.
SEGMENT_FRAME_TIMEOUT_S=8
SEGMENT_MAX_FRAME_BYTES=12582912
SEGMENT_MAX_IMAGE_PIXELS=40000000
SEGMENT_MAX_TARGETS=12

# Named-target mode.
SEGMENT_SAM3_MODEL_ID=facebook/sam3
SEGMENT_DINO_MODEL_ID=IDEA-Research/grounding-dino-tiny
SEGMENT_SAM2_MODEL_ID=facebook/sam2.1-hiera-small
SEGMENT_BOX_THRESHOLD=0.30
SEGMENT_TEXT_THRESHOLD=0.25
SEGMENT_MASK_THRESHOLD=0.5
SEGMENT_MAX_BOXES_PER_TARGET=12
SEGMENT_MIN_COMPONENT_FRAC=0.20
SEGMENT_MAX_HOLE_FRAC=0.05
SEGMENT_POLYGON_POINT_BUDGET=200

# Unnamed top-objects mode.
SEGMENT_MAX_OBJECTS=8
SEGMENT_MIN_OBJECT_AREA_FRAC=0.004
SEGMENT_MAX_OBJECT_AREA_FRAC=0.50
SEGMENT_EDGE_MARGIN_PX=3
SEGMENT_NMS_IOU=0.60
SEGMENT_NMS_CONTAINMENT=0.85
SEGMENT_AMG_POINTS_PER_SIDE=16
SEGMENT_AMG_POINTS_PER_BATCH=32

# Optional PNG alpha masks.
SEGMENT_MASK_DIR=./masks
SEGMENT_MASK_TTL_S=3600
SEGMENT_MASK_MAX_SIDE=1024
# Leave empty to build mask URLs from the request's own public hostname.
SEGMENT_MASK_PUBLIC_BASE_URL=

# Stub engine only (tests, no GPU).
SEGMENT_STUB_DIR=
